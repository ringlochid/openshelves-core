# ============================
# Database Configuration
# ============================
DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:123456@db:5432/library_app
# Sync URL for Alembic migrations (use localhost if running outside Docker)
DATABASE_SYNC_URL=postgresql+psycopg://postgres:123456@db:5432/library_app

# ============================
# Redis Configuration
# ============================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Or use full URL: REDIS_URL=redis://redis:6379/0

# ============================
# Auth Service Integration
# ============================
AUTH_SERVICE_URL=http://auth-service:8000
SERVICE_API_KEY=your_shared_secret_key_here
JWT_PUBLIC_KEY_PATH=keys/public_key.pem
JWT_ALGORITHM=RS256
JWT_ISSUER=auth-service
JWT_AUDIENCE=backend-services
AUTH_SERVICE_TIMEOUT=10

# ============================
# AWS S3 Media Storage
# ============================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=library-media-demo
# S3_ENDPOINT_URL=http://minio:9000  # For local MinIO testing

# ============================
# ClamAV (Virus Scanning)
# ============================
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ============================
# Media Processing
# ============================
# Cover sizes (book & collection) - 2:3 portrait ratio
# Default: [(1800,2700), (1200,1800), (600,900)]
# Avatar sizes (author) - 1:1 square ratio
# Default: [512, 256, 128]
COVER_OUTPUT_FORMAT=WEBP
COVER_JPEG_QUALITY=85
COVER_MAX_BYTES=10485760
BOOK_FILE_MAX_BYTES=104857600

# ============================
# Content Management
# ============================
SOFT_DELETE_WINDOW_HOURS=24

# ============================
# API Configuration
# ============================
API_TITLE=Library Service API
API_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ============================
# Rate Limiting (Token Bucket)
# ============================
# Read endpoints (GET) - generous
RATE_LIMIT_READ_CAPACITY=50
RATE_LIMIT_READ_REFILL_TOKENS=50
RATE_LIMIT_READ_PERIOD_SECONDS=120

# Write endpoints (POST/PUT/PATCH) - moderate
RATE_LIMIT_WRITE_CAPACITY=30
RATE_LIMIT_WRITE_REFILL_TOKENS=30
RATE_LIMIT_WRITE_PERIOD_SECONDS=3600

# Sensitive endpoints (jury voting, content creation)
RATE_LIMIT_SENSITIVE_CAPACITY=10
RATE_LIMIT_SENSITIVE_REFILL_TOKENS=10
RATE_LIMIT_SENSITIVE_PERIOD_SECONDS=3600

# Anonymous/IP-based rate limiting
RATE_LIMIT_ANON_CAPACITY=20
RATE_LIMIT_ANON_REFILL_TOKENS=20
RATE_LIMIT_ANON_PERIOD_SECONDS=180

# Upload rate limiting
RATE_LIMIT_UPLOAD_CAPACITY=10
RATE_LIMIT_UPLOAD_REFILL_TOKENS=10
RATE_LIMIT_UPLOAD_REFILL_PERIOD_SECONDS=3600

# Commit rate limiting
RATE_LIMIT_COMMIT_CAPACITY=10
RATE_LIMIT_COMMIT_REFILL_TOKENS=10
RATE_LIMIT_COMMIT_REFILL_PERIOD_SECONDS=3600
