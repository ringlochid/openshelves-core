# DATABASE_SYNC_URL=postgresql+psycopg://postgres:123456@localhost:5432/library_app

# ============================
# Redis Configuration
# ============================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://redis:6379/0

# ============================
# Auth Service Integration
# ============================
AUTH_SERVICE_URL=http://auth-service:8000
SERVICE_API_KEY=cZp1S8s3EzWwaqLcYCZvNCVavD_80eIm2PniGCKlt4U
JWT_PUBLIC_KEY_PATH=keys/public_key.pem
JWT_ALGORITHM=RS256
JWT_ISSUER=auth-service
JWT_AUDIENCE=backend-services
