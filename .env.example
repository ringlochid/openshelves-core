# ============================
# Database Configuration
# ============================
DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:123456@db:5432/library_app
DATABASE_SYNC_URL=postgresql+psycopg://postgres:123456@localhost:5432/library_app

# For Docker (use db hostname)
# DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:123456@db:5432/library_app
# DATABASE_SYNC_URL=postgresql+psycopg://postgres:123456@db:5432/library_app

# For Local Dev with exposed port (use localhost)
# DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:123456@localhost:5432/library_app
# DATABASE_SYNC_URL=postgresql+psycopg://postgres:123456@localhost:5432/library_app

# ============================
# Redis Configuration
# ============================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://redis:6379/0

# ============================
# Auth Service Integration
# ============================
AUTH_SERVICE_URL=http://auth-service:8000
SERVICE_API_KEY=cZp1S8s3EzWwaqLcYCZvNCVavD_80eIm2PniGCKlt4U
JWT_PUBLIC_KEY_PATH=keys/public_key.pem
JWT_ALGORITHM=RS256
JWT_ISSUER=auth-service
JWT_AUDIENCE=backend-services
AUTH_SERVICE_TIMEOUT=10

# ============================
# S3 Media Configuration
# ============================
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=library-app-media
# S3_ENDPOINT_URL=http://minio:9000  # For local MinIO testing

# ============================
# Celery Configuration
# ============================
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1

# ============================
# ClamAV (Virus Scanning)
# ============================
CLAMAV_ENABLED=false
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# ============================
# Content Management
# ============================
SOFT_DELETE_WINDOW_HOURS=24

# ============================
# API Configuration
# ============================
API_TITLE=Library Service API
API_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ============================
# Rate Limiting (Token Bucket)
# ============================
# Format: capacity / refill_tokens per refill_period_seconds
# Example: 100/100/60 means 100 max tokens, refill 100 tokens every 60 seconds

# Read endpoints (GET requests) - generous limits
RATE_LIMIT_READ_CAPACITY=100
RATE_LIMIT_READ_REFILL_TOKENS=100
RATE_LIMIT_READ_PERIOD_SECONDS=60

# Write endpoints (POST/PUT/PATCH) - moderate limits
RATE_LIMIT_WRITE_CAPACITY=30
RATE_LIMIT_WRITE_REFILL_TOKENS=30
RATE_LIMIT_WRITE_PERIOD_SECONDS=60

# Sensitive endpoints (login-like, create content) - strict limits
RATE_LIMIT_SENSITIVE_CAPACITY=10
RATE_LIMIT_SENSITIVE_REFILL_TOKENS=10
RATE_LIMIT_SENSITIVE_PERIOD_SECONDS=60

# Anonymous/IP-based rate limiting (for unauthenticated requests)
RATE_LIMIT_ANON_CAPACITY=20
RATE_LIMIT_ANON_REFILL_TOKENS=20
RATE_LIMIT_ANON_PERIOD_SECONDS=60
