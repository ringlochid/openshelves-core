# ============================
# Database Configuration
# ============================
DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:123456@db:5432/library_app
DATABASE_SYNC_URL=postgresql+psycopg://postgres:123456@localhost:5432/library_app

# For Docker (use db hostname)
# DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:123456@db:5432/library_app
# DATABASE_SYNC_URL=postgresql+psycopg://postgres:123456@db:5432/library_app

# For Local Dev with exposed port (use localhost)
